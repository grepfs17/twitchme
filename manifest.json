{
  "manifest_version": 3,
  "name": "TwitchMe",
  "version": "1.0.2",
  "description": "Auto-opens Twitch streams when channels go live",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://*.twitch.tv/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TwitchMe"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
